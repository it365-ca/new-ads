      "description": "Origine ethnoculturelle"
    },
    "genre": {
      "bsonType": "string",
      "enum": [
        "Masculin",
        "Féminin",
        "Autres"
      ],
      "description": "Genre de l'élève"
    },
    "degreScolaire": {
      "bsonType": "string",
      "enum": [
        "6eme Primaire",
        "Secondaire 1",
        "Secondaire 2",
        "Secondaire 3",
        "Secondaire 4",
        "Secondaire 5",
        "FPT",
        "FMS",
        "GADP",
        "GADSP",
        "PEP"
      ],

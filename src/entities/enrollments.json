    },
    "ville": {
      "bsonType": "string",
      "description": "Ville de résidence"
    },
    "demeurAvec": {
      "bsonType": "string",
      "enum": [
        "Ami",
        "Autre",
        "Beau-Père",
        "En résidence",
        "Foyer de groupe",
        "Garde partagée",
        "Grand-mère et Oncle",
        "Grande-Sœur",
        "Grands-parents paternels",
        "La mère",
        "Le père",
        "Les deux parents",
        "Tante",
        "Oncle",
        "Tuteur",
        "Grand-Frère"

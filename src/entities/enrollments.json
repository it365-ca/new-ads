    "directionEmail": {
      "bsonType": "string",
      "description": "Email de la direction"
    },
    "programme": {
      "bsonType": "string",
      "enum": [
        "ALT",
        "OPTION",
        "PIVOT",
        "APOSTROPHE",
        "SAUTS",
        "Suivis Estivaux"

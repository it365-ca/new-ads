{
  "name": "notes",
  "type": "object",
  "required": [
    "enrollmentId",
    "contenu",
    "auteurNom",
    "suivi",
    "creator",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "rencontreJeune": {
      "description": "Nombre de rencontres avec le jeune",
      "bsonType": "int"
    },
    "linkedDocuments": {
      "description": "Liens vers documents PDF associés",
      "bsonType": "array",
      "items": {
        "bsonType": "string"
      }
    },
    "contactAutre": {
      "bsonType": "int",
      "description": "Nombre de contacts autres"
    },
    "checklist": {
      "description": "Liste de tâches",
      "bsonType": "array",
      "items": {
        "properties": {
          "task": {
            "bsonType": "string"
          },
          "completed": {
            "bsonType": "bool"
          }
        },
        "bsonType": "object"
      }
    },
    "objectives": {
      "items": {
        "properties": {
          "description": {
            "bsonType": "string"
          },
          "progress": {
            "bsonType": "int"
          },
          "title": {
            "bsonType": "string"
          },
          "dueDate": {
            "bsonType": "string",

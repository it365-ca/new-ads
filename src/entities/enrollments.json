        "emulation": {
          "bsonType": "bool"
        },
        "rencontreParents": {
          "bsonType": "bool"
        },
        "horaireAdapte": {
          "bsonType": "bool"
        },
        "suiviTES": {
          "bsonType": "bool"
        },
        "planIntervention": {
          "bsonType": "bool"
        },
        "suiviPsycho": {
          "bsonType": "bool"
        },
        "rencontreTutrice": {
          "bsonType": "bool"
        }
      }
    },
    "suiviExterne": {
      "bsonType": "string",
      "description": "Suivi externe (optionnel)"
    },
    "motivationsAdolescent": {
      "bsonType": "string",

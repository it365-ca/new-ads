    "nom",
    "prenom",
    "dateNaissance",
    "age",
    "origine",
    "genre",
    "degreScolaire",
    "adresse",
    "codePostal",
    "ville",
    "demeurAvec",
    "parent1Type",
    "parent1Nom",
    "parent1Prenom",
    "parent1Tel",
    "parent1Email",
    "contactUrgence",
    "contactUrgenceTel",
    "contactUrgenceLien",
    "epipen",
    "ecoleReferente",
    "intervenantNom",
    "intervenantTitre",

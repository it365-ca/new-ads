    "motifReference": {
      "bsonType": "string",
      "description": "Motif principal de référence"
    },
    "moyensProposesAutres": {
      "bsonType": "string",
      "description": "Autres moyens proposés (optionnel)"
    },
    "moyensProposesChecked": {
      "bsonType": "object",
      "description": "Moyens proposés cochés",

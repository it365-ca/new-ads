    },
    "prenom": {
      "bsonType": "string",
      "description": "Prénom de l'élève"
    },
    "dateNaissance": {
      "bsonType": "string",
      "title": "datetime",
      "description": "Date de naissance (ISO 8601)"
    },
    "age": {
      "bsonType": "int",
      "description": "Âge de l'élève",
      "minimum": 10,
      "maximum": 20
    },
    "origine": {
      "bsonType": "string",
      "enum": [
        "Canadienne",
        "Asiatique occidental",
        "Asiatique du Sud-Est",
        "Europe de l'est/l'ouest",
        "Sud-Asiatique",
        "Latino-Américaine",
        "Arabe",
        "Africaine",
        "Haïtienne",
        "Chinoise",
        "Autochtone"

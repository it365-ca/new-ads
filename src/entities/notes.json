        "dateCreation": {
          "bsonType": "string"
        },
        "rappelsSuivis": {
          "bsonType": "string"
        },
        "rencontreJeune": {
          "bsonType": "int"
        },
        "typeActivite": {
          "bsonType": "string"
        },
        "ecole": {
          "bsonType": "string"
        },
        "rencontreScolaire": {
          "bsonType": "int"
        },
        "horaire": {
          "bsonType": "string"
        },
        "activite": {
          "bsonType": "string"
        },
        "rencontreAutre": {
          "bsonType": "int"
        },
        "contactParent": {
          "bsonType": "int"
        },
        "contactScolaire": {
          "bsonType": "int"
        },
        "contactAutre": {
          "bsonType": "int"
        },
        "elevesPresents": {
          "bsonType": "string"
        },
        "intervenant": {
          "bsonType": "string"
        },
        "rencontreParent": {
          "bsonType": "int"
        },
        "contactJeune": {
          "bsonType": "int"
        },
        "dateEvenement": {
          "bsonType": "string"
        },
        "elevesAbsents": {
          "bsonType": "string"
        }
      },
      "bsonType": "object"
    },

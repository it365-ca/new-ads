          "label": {
            "bsonType": "string"
          },
          "date": {
            "bsonType": "string",
            "title": "datetime"
          },
          "value": {
            "bsonType": "int"
          }
        }
      }
    },
    "createdAt": {
      "bsonType": "string",
      "description": "Date de création (ISO 8601)",

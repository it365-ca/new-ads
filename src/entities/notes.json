      "bsonType": "int",
      "description": "Nombre de contacts avec le jeune"
    },
    "rencontreAutre": {
      "description": "Nombre de rencontres autres",
      "bsonType": "int"
    },
    "suivi": {
      "description": "Indique si la note a été traitée/suivie",
      "bsonType": "bool"
    },
    "contenu": {
      "description": "Contenu de la note de suivi",
      "bsonType": "string"
    },
    "template": {
      "bsonType": "string",
      "description": "Nom du modèle utilisé"
    },
    "mentions": {
      "description": "Intervenants mentionnés (@nom)",
      "bsonType": "array",
      "items": {
        "bsonType": "string"
      }
    },
    "tags": {
      "description": "Tags/Étiquettes pour catégoriser",
      "items": {
        "bsonType": "string"
      },
      "bsonType": "array"
    },
    "attachments": {
      "description": "Pièces jointes (fichiers/images)",
      "items": {
        "properties": {
          "fileType": {
            "bsonType": "string"
          },
          "fileUrl": {
            "bsonType": "string"
          },
          "fileName": {
            "bsonType": "string"
          }
        },
        "bsonType": "object"
      },
      "bsonType": "array"
    },
    "dateCreation": {
      "description": "Date de création personnalisée (ISO 8601)",
      "title": "datetime",
      "bsonType": "string"
    },
    "nombreScolaire": {
      "description": "Nombre scolaire",
      "bsonType": "int"
    },
    "status": {
      "bsonType": "string",
      "enum": [
        "actif",
        "ferme",
        "supprime"
      ],
      "description": "Statut de la note: actif, fermé ou supprimé"
    },
    "reminders": {
      "description": "Rappels automatiques",
      "items": {
        "bsonType": "object",
        "properties": {
          "completed": {
            "bsonType": "bool"
          },
          "message": {
            "bsonType": "string"
          },
          "date": {
            "title": "datetime",
            "bsonType": "string"
          }
        }
      },
      "bsonType": "array"
    },
    "couleur": {
      "bsonType": "string",
      "description": "Couleur du post-it (yellow, pink, blue, green, orange, purple)"
    },
    "position": {
      "bsonType": "object",
      "description": "Position du post-it sur le tableau",
      "properties": {
        "x": {
          "bsonType": "double"
        },
        "y": {
          "bsonType": "double"
        }
      }
    },
    "categorie": {
      "bsonType": "string",
      "description": "Catégorie du post-it (principal, telephone, rencontre, urgent, general)"
    },
    "ecole": {
      "bsonType": "string",
      "description": "École associée au post-it"
    },
    "rappel": {
      "bsonType": "object",
      "description": "Rappel de rendez-vous",
      "properties": {
        "date": {
          "bsonType": "string",
          "title": "datetime"
        },
        "heure": {
          "bsonType": "string"
        },
        "type": {
          "bsonType": "string",
          "enum": ["telephone_parent", "telephone_eleve", "rencontre", "suivi", "autre"]
        },
        "description": {
          "bsonType": "string"
        }
      }
    }
  }
